{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "files-tools",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/sitemap.xml", "/robots.txt"]
  },
  "observability": {
    "enabled": true
  }
}
